  "components": {
    "schemas": {
      "ArtifactItem": {
        "properties": {
          "artifact_id": {
            "type": "string",
            "title": "Artifact Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "image_id": {
            "type": "string",
            "title": "Image Id"
          },
          "artifact_type": {
            "type": "string",
            "title": "Artifact Type"
          },
          "corruption": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corruption"
          },
          "severity": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity"
          },
          "mime_type": {
            "type": "string",
            "title": "Mime Type",
            "default": "image/jpeg"
          },
          "available": {
            "type": "boolean",
            "title": "Available",
            "default": true
          },
          "details": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "artifact_id",
          "run_id",
          "image_id",
          "artifact_type"
        ],
        "title": "ArtifactItem"
      },
      "ConditionResult": {
        "properties": {
          "corruption": {
            "$ref": "#/components/schemas/CorruptionKind"
          },
          "severity": {
            "type": "integer",
            "title": "Severity"
          },
          "seed": {
            "type": "integer",
            "title": "Seed"
          },
          "metrics": {
            "$ref": "#/components/schemas/MetricSet"
          },
          "per_image": {
            "items": {
              "$ref": "#/components/schemas/ImageConditionResult"
            },
            "type": "array",
            "title": "Per Image"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "corruption",
          "severity",
          "seed",
          "metrics",
          "per_image"
        ],
        "title": "ConditionResult"
      },
      "CorruptionKind": {
        "type": "string",
        "enum": [
          "blur",
          "low_light",
          "gaussian_noise"
        ],
        "title": "CorruptionKind"
      },
      "CorruptionSpec": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/CorruptionKind"
          },
          "severities": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "minItems": 1,
            "title": "Severities"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "severities"
        ],
        "title": "CorruptionSpec"
      },
      "DatasetInfo": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "image_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Image Count"
          },
          "has_ground_truth": {
            "type": "boolean",
            "title": "Has Ground Truth"
          },
          "license": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_id",
          "name",
          "image_count",
          "has_ground_truth"
        ],
        "title": "DatasetInfo"
      },
      "DatasetMetadata": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "image_count": {
            "type": "integer",
            "title": "Image Count"
          },
          "has_ground_truth": {
            "type": "boolean",
            "title": "Has Ground Truth",
            "default": false
          },
          "supported": {
            "type": "boolean",
            "title": "Supported",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "image_count"
        ],
        "title": "DatasetMetadata"
      },
      "DatasetsResponse": {
        "properties": {
          "datasets": {
            "items": {
              "$ref": "#/components/schemas/DatasetMetadata"
            },
            "type": "array",
            "title": "Datasets"
          }
        },
        "type": "object",
        "required": [
          "datasets"
        ],
        "title": "DatasetsResponse"
      },
      "EvalConfig": {
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1,
            "title": "Model Id"
          },
          "dataset_id": {
            "type": "string",
            "minLength": 1,
            "title": "Dataset Id"
          },
          "corruptions": {
            "items": {
              "$ref": "#/components/schemas/CorruptionSpec"
            },
            "type": "array",
            "minItems": 1,
            "title": "Corruptions"
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "default": 0
          },
          "score_threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score Threshold",
            "default": 0.5
          },
          "match_iou_threshold": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Match Iou Threshold",
            "default": 0.5
          },
          "max_images": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Images"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model_id",
          "dataset_id",
          "corruptions"
        ],
        "title": "EvalConfig"
      },
      "EvaluationReport": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "1.0.0"
          },
          "is_fixture": {
            "type": "boolean",
            "title": "Is Fixture",
            "default": false
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "model": {
            "$ref": "#/components/schemas/ModelInfo"
          },
          "dataset": {
            "$ref": "#/components/schemas/DatasetInfo"
          },
          "config": {
            "$ref": "#/components/schemas/EvalConfig"
          },
          "clean_predictions": {
            "items": {
              "$ref": "#/components/schemas/ImagePredictions"
            },
            "type": "array",
            "title": "Clean Predictions"
          },
          "conditions": {
            "items": {
              "$ref": "#/components/schemas/ConditionResult"
            },
            "type": "array",
            "title": "Conditions"
          },
          "failures": {
            "items": {
              "$ref": "#/components/schemas/FailureInfo"
            },
            "type": "array",
            "title": "Failures"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ImageError"
            },
            "type": "array",
            "title": "Errors"
          },
          "ground_truth_metrics": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ground Truth Metrics"
          },
          "software_versions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Software Versions"
          },
          "metric_definitions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Metric Definitions"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "status",
          "created_at",
          "model",
          "dataset",
          "config",
          "clean_predictions",
          "conditions",
          "failures"
        ],
        "title": "EvaluationReport"
      },
      "FailureInfo": {
        "properties": {
          "image_id": {
            "type": "string",
            "title": "Image Id"
          },
          "corruption": {
            "$ref": "#/components/schemas/CorruptionKind"
          },
          "severity": {
            "type": "integer",
            "title": "Severity"
          },
          "failure_type": {
            "$ref": "#/components/schemas/FailureType"
          },
          "clean_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clean Index"
          },
          "corrupted_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corrupted Index"
          },
          "clean_prediction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Prediction"
              },
              {
                "type": "null"
              }
            ]
          },
          "corrupted_prediction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Prediction"
              },
              {
                "type": "null"
              }
            ]
          },
          "iou": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Iou"
          },
          "details": {
            "type": "string",
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "image_id",
          "corruption",
          "severity",
          "failure_type",
          "details"
        ],
        "title": "FailureInfo"
      },
      "FailureType": {
        "type": "string",
        "enum": [
          "MISSING_AFTER_CORRUPTION",
          "NEW_AFTER_CORRUPTION",
          "CLASS_FLIP",
          "LOCALIZATION_SHIFT",
          "CONFIDENCE_DROP"
        ],
        "title": "FailureType"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageConditionResult": {
        "properties": {
          "image_id": {
            "type": "string",
            "title": "Image Id"
          },
          "corrupted_image_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corrupted Image Path"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/Prediction"
            },
            "type": "array",
            "title": "Predictions"
          },
          "matches": {
            "items": {
              "$ref": "#/components/schemas/MatchRecord"
            },
            "type": "array",
            "title": "Matches"
          },
          "unmatched_clean_indices": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Unmatched Clean Indices"
          },
          "unmatched_corrupted_indices": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Unmatched Corrupted Indices"
          },
          "metrics": {
            "$ref": "#/components/schemas/MetricSet"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "image_id",
          "predictions",
          "matches",
          "unmatched_clean_indices",
          "unmatched_corrupted_indices",
          "metrics"
        ],
        "title": "ImageConditionResult"
      },
      "ImageError": {
        "properties": {
          "image_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Id"
          },
          "stage": {
            "type": "string",
            "title": "Stage"
          },
          "corruption": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CorruptionKind"
              },
              {
                "type": "null"
              }
            ]
          },
          "severity": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stage",
          "message"
        ],
        "title": "ImageError"
      },
      "ImagePredictions": {
        "properties": {
          "image_id": {
            "type": "string",
            "minLength": 1,
            "title": "Image Id"
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Height"
          },
          "image_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Path"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/Prediction"
            },
            "type": "array",
            "title": "Predictions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "image_id",
          "width",
          "height",
          "predictions"
        ],
