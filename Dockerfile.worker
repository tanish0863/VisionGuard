# =============================================================================
# VisionGuard — GPU Evaluation Worker Dockerfile
# =============================================================================
ARG BASE_IMAGE=nvidia/cuda:12.4.1-runtime-ubuntu22.04
FROM ${BASE_IMAGE}

USER root

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install Python 3.12 and dependencies (if not already present in base image)
RUN if ! command -v python3.12 >/dev/null 2>&1; then \
        apt-get update && apt-get install -y --no-install-recommends \
            software-properties-common \
            curl \
            libpq5 \
            libgl1 \
            libglib2.0-0 \
        && add-apt-repository ppa:deadsnakes/ppa \
        && apt-get update && apt-get install -y --no-install-recommends \
            python3.12 \
            python3.12-venv \
            python3.12-dev \
        && rm -rf /var/lib/apt/lists/*; \
    fi

# Create virtual environment if missing
RUN if [ ! -d "/opt/venv" ]; then \
        python3.12 -m venv /opt/venv; \
    fi
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app"

# Install dedicated worker ML & database requirements
COPY backend/requirements-ml.txt /app/backend/requirements-ml.txt

RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r /app/backend/requirements-ml.txt --extra-index-url https://download.pytorch.org/whl/cu124

# Copy application source, contracts, and demo data
COPY visionguard_contracts /app/visionguard_contracts
COPY backend /app/backend

# Create non-root user and persistent cache/artifact directories
RUN id -u appuser >/dev/null 2>&1 || useradd -u 1000 -m appuser \
    && mkdir -p /home/appuser/.cache /app/backend/artifacts \
    && chown -R appuser:appuser /home/appuser /app /opt/venv

USER appuser

ENV PORT=7860
EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-7860}/health || exit 1

CMD ["python", "-m", "backend.app.worker", "--poll", "--interval", "2.0"]
