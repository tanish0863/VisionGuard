# =============================================================================
# VisionGuard — Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure with your credentials:
#   Copy-Item .env.example .env

# Database Connection (Neon Serverless PostgreSQL or local PostgreSQL with TLS)
# Format: postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Evaluator entry point (defaults to real ML engine)
VISIONGUARD_EVALUATOR=backend.visionguard.core.pipeline:evaluate_run

# Supported model IDs (comma-separated)
VISIONGUARD_SUPPORTED_MODELS=fasterrcnn_resnet50_fpn,fasterrcnn_resnet50_fpn_v2

# Allowed CORS origins for frontend integration (comma-separated)
# Defaults to: http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
VISIONGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000


# Dedicated test database URL for postgres connectivity integration tests (optional)
# TEST_DATABASE_URL=postgresql+psycopg://TEST_USER:TEST_PASSWORD@TEST_HOST/TEST_DB?sslmode=require

# Execution Dispatcher Mode: "background" (FastAPI in-process) or "worker" (decoupled worker)
# Default is "background" for local single-process development; use "worker" for production
VISIONGUARD_DISPATCHER=background

# Worker lease and crash recovery configuration
VISIONGUARD_LEASE_TIMEOUT_SECONDS=60
VISIONGUARD_MAX_ATTEMPTS=3

# Frontend Environment Variable (set in frontend/.env or build environment)
# VITE_API_BASE_URL=http://127.0.0.1:8000
